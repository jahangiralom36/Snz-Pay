<?xml version="1.0" encoding="utf-8"?>
<!--
  🖼️ অ্যাপের লোগো — নিজের লোগো দিতে চাইলে:
  ১. এই ফাইলটা (app_logo.xml) ডিলিট করুন
  ২. নিজের লোগো PNG ছবি "app_logo.png" নামে এই drawable ফোল্ডারে রাখুন (512x512, 200KB এর কম)
  ব্যস — অ্যাপের ভেতরের লোগো আর ফোনের হোম স্ক্রিনের আইকন দুটোই বদলে যাবে।
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0B2559" />
        </shape>
    </item>
    <item
        android:bottom="16dp"
        android:drawable="@drawable/app_logo_mark"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp" />
</layer-list>
