<?xml version="1.0" encoding="utf-8"?>
<!-- ≡ মেনু পপআপ — ওয়েবসাইটের মত প্রিমিয়াম ডার্ক ডিজাইন -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDialogIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#00D9FF"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SNZ Pay Controller"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Gateway &amp; Security Overview"
                android:textColor="#00D89A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Info box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_premium_inner"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LICENSE VALIDITY" android:textColor="#64748B" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView
            android:id="@+id/tvDialogValidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="VIP Lifetime Active"
            android:textColor="#00D9FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="DEVICE SECURITY" android:textColor="#64748B" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="🔒 Locked &amp; Encrypted" android:textColor="#00D89A" android:textSize="14sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GATEWAY SERVICE" android:textColor="#64748B" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="● 24/7 Live Active" android:textColor="#FFFFFF" android:textSize="14sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SMS UPLOAD" android:textColor="#64748B" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView
            android:id="@+id/tvDialogSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="All SMS uploaded ✓"
            android:textColor="#00D89A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Buttons -->
    <TextView
        android:id="@+id/btnDialogHistory"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_premium_btn"
        android:gravity="center"
        android:text="📜  ALL HISTORY"
        android:textColor="#061535"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDialogSyncNow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_premium_btn_outline"
        android:gravity="center"
        android:text="🔄  SYNC NOW"
        android:textColor="#00D9FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogLogout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_premium_btn_outline"
            android:gravity="center"
            android:text="LOGOUT KEY"
            android:textColor="#F87171"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDialogClose"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_premium_btn_outline"
            android:gravity="center"
            android:text="CLOSE"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
