<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHistoryBack"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/bg_menu_btn"
            android:text="←"
            android:textColor="#0284C7"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All SMS History"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistorySummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 transactions"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_blue"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView android:id="@+id/tabAll" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:gravity="center" android:text="All" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tabToday" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:gravity="center" android:text="Today" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tabUploaded" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:gravity="center" android:text="Uploaded" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tabWaiting" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:gravity="center" android:text="Waiting" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="No SMS found."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
