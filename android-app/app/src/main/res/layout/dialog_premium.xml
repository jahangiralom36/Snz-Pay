<?xml version="1.0" encoding="utf-8"?>
<!-- প্রিমিয়াম পপআপ (ওয়েবসাইটের ডিজাইনের মত) — PremiumDialog.java এটা ব্যবহার করে -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pmCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tvPmIcon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:text="⚡"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tvPmBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="NOTICE"
        android:textColor="#00D9FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPmMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Message"
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPmInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_premium_inner"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:maxLines="14"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:text=""
        android:textColor="#E2E8F0"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnPmPrimary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_premium_btn"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:text="OK"
        android:textColor="#061535"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPmSecondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_premium_btn_outline"
        android:gravity="center"
        android:text="Close"
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
