<?xml version="1.0" encoding="utf-8"?>
<!-- ওয়েবসাইটের snz-gradient বাটন (নীল → সায়ান → সবুজ) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#0062CC" android:centerColor="#00B8D9" android:endColor="#00B583" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#007BFF" android:centerColor="#00D9FF" android:endColor="#00D89A" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
