# ⚡ SNZPay speed settings (Apache / LiteSpeed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType application/vnd.android.package-archive "access plus 1 hour"
</IfModule>
AddType application/vnd.android.package-archive .apk

# সংবেদনশীল ফাইল ব্রাউজার থেকে লুকানো
<FilesMatch "^(\.db_indexes_v1|\.db_heal_v2|payment_settings\.json|app-release\.apk\.tmp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
